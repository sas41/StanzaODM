@model SourceDetailsModel
@{ ViewData["Title"] = "Sources — " + Model.Deployment.Name; var d = Model.Deployment; }
<div class="page-heading"><div><span class="eyebrow">GIT &amp; REGISTRY SOURCES</span><h1>@d.Name — sources</h1><p>Connect repositories, choose references, and bind private registry access.</p></div>
<div class="toolbar"><a class="button subtle" href="/deployments/@d.DeploymentId">Deployment / manually authored Compose</a>@if (d.CanManage) { <a class="button primary" href="/sources/@d.DeploymentId/edit">Add Git source</a> }</div></div>
@if (!d.TargetAgentId.HasValue) { <p class="notice warning" role="alert">No Agent is selected. Choose an approved deployment Agent before browsing references or executing workloads.</p> }
@if (!d.CanManage) { <p class="notice info">Read-only. Editing sources requires sources.manage and files.write for this deployment.</p> }
<div class="workspace"><div>
@if (d.Git.Count == 0) { <p class="empty-state">No Git sources. Public repositories need no credential. Image-only services can use this deployment without a Git source.</p> }
@for (var index = 0; index < d.Git.Count; index++)
{
    var item = d.Git[index];
    <section class="panel"><div class="panel-heading"><h2>@(index + 1). @item.Destination</h2><span class="badge neutral">@(item.CredentialId.HasValue ? "Authenticated" : "Public repository")</span></div>
        <p><code>@item.Url</code></p>
        <form method="post" action="/sources/@d.DeploymentId/save" data-branch-form class="form-grid">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@item.Id" /><input type="hidden" name="ExpectedVersion" value="@item.Version" />
            <input type="hidden" name="Url" value="@item.Url" /><input type="hidden" name="Destination" value="@item.Destination" /><input type="hidden" name="CredentialId" value="@item.CredentialId" />
            <label class="field">Branch/tag/commit<input name="Reference" value="@item.Reference" maxlength="256" required readonly="@(!d.CanManage)" /></label>
            <label class="field">Search remote references<input type="search" name="search" placeholder="Filter branches and tags" hx-get="/sources/@d.DeploymentId/@item.Id/branches" hx-trigger="input changed delay:400ms, search" hx-target="#branches-@item.Id" hx-indicator="#loading-@item.Id" /></label>
            <div id="branches-@item.Id" class="span-full" hx-get="/sources/@d.DeploymentId/@item.Id/branches" hx-trigger="load" hx-indicator="#loading-@item.Id" aria-live="polite"><p class="field-help">Loading branch and tag list from the deployment Agent…</p></div>
            <div class="toolbar span-full">
                @if (d.CanManage) { <button class="button primary" type="submit">Save selected reference</button> }
                <button class="button" type="button" hx-get="/sources/@d.DeploymentId/@item.Id/branches" hx-target="#branches-@item.Id" hx-include="closest form" hx-params="search" hx-indicator="#loading-@item.Id">Refresh references</button>
                <span id="loading-@item.Id" class="htmx-indicator" role="status" hidden>Loading remote references…</span>
            </div>
        </form>
        @if (d.CanManage)
        {
            <div class="toolbar"><a class="button subtle" href="/sources/@d.DeploymentId/edit?id=@item.Id">Edit endpoint / destination</a>
            <form method="post" action="/sources/@d.DeploymentId/delete">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="expectedVersion" value="@item.Version" /><button class="button danger" type="submit">Remove source</button></form>
            @if (index > 0)
            {
                var ordered = d.Git.ToList(); (ordered[index - 1], ordered[index]) = (ordered[index], ordered[index - 1]);
                <form method="post" action="/sources/@d.DeploymentId/reorder">@Html.AntiForgeryToken()
                    @foreach (var source in ordered) { <input type="hidden" name="ids" value="@source.Id" /><input type="hidden" name="versions" value="@source.Version" /> }
                    <button class="button" type="submit">Move earlier</button>
                </form>
            }
            </div>
        }
    </section>
}
</div><aside>
    <section class="panel"><h2>Branch selector on an action</h2><p>In the action editor, select this deployment, add a <strong>branch</strong> input, and choose the source checkout destination above. A <strong>deploy</strong> step builds and applies the selection.</p><a class="button" href="/automation/actions/edit">Create an action</a></section>
    <section class="panel"><h2>Private registry bindings</h2><p class="field-help">Public registries need no credentials. Bind at most one credential per registry endpoint. Usage is checked again at execution time.</p>
        <form method="post" action="/sources/@d.DeploymentId/registries">@Html.AntiForgeryToken()
            @foreach (var id in d.RegistryCredentialIds) { <input type="hidden" name="expectedCredentialIds" value="@id" /> }
            @foreach (var c in Model.Credentials.Where(x => x.Kind == "registry"))
            { <label><input type="checkbox" name="credentialIds" value="@c.Id" checked="@(d.RegistryCredentialIds.Contains(c.Id))" disabled="@(!d.CanManage)" /> @c.Name — @c.Endpoint</label> }
            @foreach (var id in d.RegistryCredentialIds.Where(id => Model.Credentials.All(c => c.Id != id)))
            { <p class="notice warning" role="alert">Bound credential @id is not usable by your account. Remove it or request credential.use permission.</p> }
            @if (d.CanManage) { <button class="button primary" type="submit">Save registry bindings</button> }
        </form><p class="field-help"><a href="/credentials">Manage credentials / registries →</a></p>
    </section>
    <details class="panel help-disclosure"><summary>Checkout and Compose rules</summary><p class="field-help">Checkouts are isolated build inputs, not browser-editable files. Use each destination as a relative Compose build context. Compose remains manually managed. Submodules are unsupported: repositories containing .gitmodules are rejected, not initialized. Operation history records resolved commits.</p></details>
</aside></div>
<script src="~/js/branches.js" asp-append-version="true" defer></script>
