@model EditDeploymentModel
@{ ViewData["Title"] = "Edit deployment draft"; }
<span class="eyebrow">DRAFT EDITOR</span><h1>Edit deployment draft</h1>
<p class="muted">Editing saved revision @Model.ExpectedRevision. Saving creates a new immutable revision; it does not deploy anything.</p>
<section class="panel"><form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <input asp-for="ExpectedRevision" type="hidden" />
    <div class="form-grid">
    <div class="field"><label asp-for="Name">Draft name</label><input asp-for="Name" maxlength="100" autocomplete="off" /></div>
    <div class="field"><label asp-for="TargetAgentId">Target Agent</label><select asp-for="TargetAgentId"><option value="">Unassigned draft</option>@if (Model.TargetAgentId.HasValue && !Model.Agents.Any(x => x.Id == Model.TargetAgentId)) { <option value="@Model.TargetAgentId">Unavailable current target — choose an approved Agent or explicitly unassign</option> }@foreach (var agent in Model.Agents) { <option value="@agent.Id">@agent.Hostname · @agent.Id</option> }</select></div>
    </div>
    <p class="field-help">Only approved Agents with agent.read access are available. Changing the target never rewrites .env.</p>
    <div class="editor-columns">
    @if (Model.CanEditCompose)
    {
        <div class="field"><label asp-for="ComposeText">Main Compose file (compose.yaml)</label><textarea asp-for="ComposeText" rows="24" class="code-editor" data-language="compose" spellcheck="false" autocomplete="off"></textarea></div>
    }
    else { <p class="muted">Compose content is hidden without files.read permission and will be preserved.</p> }
    @if (Model.CanEditEnvironment)
    {
        <div class="field"><label asp-for="EnvironmentText">Deployment environment (.env)</label><textarea asp-for="EnvironmentText" rows="14" class="code-editor" data-language="env" spellcheck="false" autocomplete="off"></textarea></div>
    }
    else { <p class="muted">Environment content is hidden or read-only without environment.reveal and environment.write. Existing text will be preserved.</p> }
    </div>
    <p class="field-help">Unchanged text retains its original line endings; edited text uses the line endings submitted by your browser. Downloads preserve stored UTF-8 bytes exactly. Highlighting is visual only, not validation. Save first, then request Docker Compose validation.</p>
    <div class="form-actions"><button class="button primary" type="submit">Save new draft revision</button> <a class="button" asp-action="Details" asp-route-id="@Model.Id">Reload latest / cancel</a></div>
</form></section>
<section id="deployment-actions"><div class="section-heading"><h2>Deployment actions</h2></div>
<p class="field-help">Actions in this scope can target only this deployment. Names are unique within the scope, ignoring case. Action saves are separate from the draft above and require action permissions.</p>
@{ ViewData["DeploymentId"] = Model.Id; }
@foreach (var action in Model.Actions) { <partial name="_DeploymentAction" model="action" /> }
@if (Model.Actions.Count == 0) { <p class="muted">No editable actions in this deployment scope.</p> }
@if (Model.CanCreateAction)
{
    <details class="panel"><summary>Add deployment action</summary>
    @await Html.PartialAsync("_DeploymentAction", new ActionEditorModel { PlanJson = System.Text.Json.JsonSerializer.Serialize(new Stanza.ControlPlane.Automation.ActionPlan([new("deploy", Model.Id)], DeploymentId: Model.Id), Stanza.ControlPlane.Automation.AutomationRules.Json) })
    <a class="button" href="/automation/actions/edit?deploymentId=@Model.Id">Create in visual editor</a></details>
}
</section>
<template id="action-deployment-options"><option value="@Model.Id">@Model.Name</option></template>
<template id="action-agent-options"><option value="">Host execution requires Global scope</option></template>
<template id="action-source-options"><option value="">Select Git source destination</option>
@foreach (var source in ViewData["ActionSources"] as IReadOnlyList<Stanza.ControlPlane.Sources.GitSourceSummary> ?? []) { <option value="@source.Destination" data-deployment="@Model.Id">@source.Destination</option> }
</template>
<script src="~/js/action-editor.js" defer asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/editor.css" asp-append-version="true" />
<script src="~/js/editor.js" asp-append-version="true" defer></script>
