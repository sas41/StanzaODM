@model DeploymentListModel
@{ ViewData["Title"] = "Deployments"; }
<span class="eyebrow">MANAGED CONFIGURATION AND WORKLOADS</span><h1>Deployments</h1>
<p class="muted">Encrypted configuration drafts with immutable revision history. Saving a draft never starts or changes workloads.</p>
<p class="field-help">Configuration synchronizes to the assigned Agent. Use explicit operations to validate, deploy, or inspect workloads. Last observed state is not a continuous health guarantee.</p>
@if (Model.CanCreate) { <p><a class="button primary" asp-action="Create">Create deployment draft</a></p> }
<section class="panel">
@if (Model.Drafts.Count == 0)
{
    <h2>No accessible deployment drafts</h2><p class="muted">An administrator can create a draft or grant access to an existing one. Creating a draft does not automatically grant an ordinary User read access.</p>
}
else
{
    <table><thead><tr><th>Name</th><th>Runtime state</th><th>Agent reference</th><th>Saved / deployed revision</th></tr></thead><tbody>
    @foreach (var draft in Model.Drafts)
    {
        var runtime = Model.Runtime.GetValueOrDefault(draft.Id);
        <tr><td><a asp-action="Details" asp-route-id="@draft.Id">@draft.Name</a></td><td>
        @if (runtime is null) { <span>Not yet observed</span> }
        else { <span>Desired: @runtime.DesiredState · Last observed: @runtime.ObservedState</span><br /><span class="muted">@runtime.Availability</span> }
        </td><td>@(draft.TargetAgentId?.ToString() ?? "Unassigned")</td><td>@draft.Revision / @(runtime is { Revision: > 0 } ? runtime.Revision.ToString() : "None / unknown")</td></tr>
    }
    </tbody></table>
}
</section>
