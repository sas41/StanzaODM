@model ActionEditorModel
@{ var deployment = (Guid)ViewData["DeploymentId"]!; var key = Model.Id?.ToString("N") ?? "new"; }
<section class="panel" data-deployment-action>
<form method="post" action="/deployments/@deployment/actions/save" hx-post="/deployments/@deployment/actions/save" hx-target="closest [data-deployment-action]" hx-swap="outerHTML">
@Html.AntiForgeryToken()<input name="Id" type="hidden" value="@Model.Id" /><input name="Revision" type="hidden" value="@Model.Revision" />
<div asp-validation-summary="All" class="validation" role="alert"></div>
@if (ViewData["ActionSaved"] is true) { <p class="notice success" role="status">Action saved.</p> }
<label for="name-@key">Name</label><input id="name-@key" name="Name" value="@Model.Name" maxlength="100" required />
@await Html.PartialAsync("_WorkflowFields", Model)
<label class="check-field"><input name="Enabled" type="checkbox" value="true" checked="@Model.Enabled" /> Enabled</label><input name="Enabled" type="hidden" value="false" />
<div class="form-actions"><button class="button primary" type="submit">Save action</button>
@if (Model.Id is { } actionId) { <a class="button danger" href="/automation/actions/@actionId/delete">Delete action…</a> }
</div>
</form></section>
