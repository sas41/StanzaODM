@model SystemStatusModel
<div class="status-grid"><div class="stat-card"><span>DATABASE</span><strong data-database-status>@(Model.DatabaseReady ? "Connected" : "Unavailable")</strong><small>PostgreSQL persistence</small></div><div class="stat-card"><span>AGENT REGISTRATIONS</span><strong data-agent-count>@(Model.AgentCount?.ToString() ?? "Restricted")</strong><small><span data-pending-agent-count>@(Model.PendingAgentCount?.ToString() ?? "—")</span> awaiting approval · not a workload health check</small></div><div class="stat-card"><span>RUNTIME</span><strong>Docker</strong><small>Podman adapter planned for the future</small></div></div>
