@model Stanza.ControlPlane.Sources.CredentialSecret
@{ ViewData["Title"] = "Credential secret"; }
<h1>Credential secret</h1>
<p role="alert">These values are sensitive. Do not paste them into logs or share this page.</p>
<section class="panel"><dl><dt>Username</dt><dd><code>@Model.Username</code></dd><dt>Password / token</dt><dd><code>@Model.Password</code></dd></dl></section>
<a href="/credentials">Close secret</a>
