@model CredentialEditModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Rotate credential" : "Create credential"; }
<h1>@ViewData["Title"]</h1>
<div asp-validation-summary="All" class="validation" role="alert"></div>
<form method="post" action="/credentials/save" class="panel" autocomplete="off">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <label asp-for="Name"></label><input asp-for="Name" required maxlength="100" />
    <label asp-for="Kind">Credential type</label>
    <select asp-for="Kind"><option value="git">Git HTTPS username / token</option><option value="registry">Container registry username / token</option></select>
    <label asp-for="Endpoint">Endpoint</label><input asp-for="Endpoint" required maxlength="2048" />
    <p>Git: exact HTTPS repository URL, without credentials. Registry: host[:port], or HTTPS URL without a path. Public registries need no binding. SSH keys, insecure HTTP, submodules, local files, and embedded URL passwords are not supported.</p>
    <label asp-for="Username"></label><input asp-for="Username" required maxlength="512" autocomplete="off" />
    <label asp-for="Password">Password / access token</label><input asp-for="Password" type="password" required maxlength="16384" autocomplete="new-password" value="" />
    <p>Editing replaces both username and password/token. Existing secrets are never pre-filled. Unbind a credential before changing its endpoint or type.</p>
    <button class="button primary" type="submit">Encrypt and save</button><a class="button" href="/credentials">Cancel</a>
</form>
