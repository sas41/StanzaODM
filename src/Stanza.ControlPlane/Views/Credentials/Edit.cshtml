@model CredentialEditModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Rotate credential" : "Create credential"; }
<div class="page-heading"><div><span class="eyebrow">AUTHENTICATED ACCESS</span><h1>@ViewData["Title"]</h1><p>Store credentials for private Git repositories and container registries.</p></div><a class="button subtle" href="/credentials">All credentials</a></div>
<div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="workspace">
<form method="post" action="/credentials/save" class="panel form-grid" autocomplete="off">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <div class="field"><label asp-for="Name"></label><input asp-for="Name" required maxlength="100" placeholder="GitHub application access" /></div>
    <div class="field"><label asp-for="Kind">Credential type</label><select asp-for="Kind"><option value="git">Git HTTPS username / token</option><option value="registry">Container registry username / token</option></select></div>
    <div class="field span-full"><label asp-for="Endpoint">Endpoint</label><input asp-for="Endpoint" required maxlength="2048" placeholder="https://github.com/organization/application.git" /><p class="field-help">Git: exact HTTPS repository URL. Registry: host[:port] or an HTTPS origin, without a path.</p></div>
    <div class="field"><label asp-for="Username"></label><input asp-for="Username" required maxlength="512" autocomplete="off" /></div>
    <div class="field"><label asp-for="Password">Password / access token</label><input asp-for="Password" type="password" required maxlength="16384" autocomplete="new-password" value="" /></div>
    <p class="field-help span-full">Editing replaces both username and password/token. Existing secrets are never pre-filled. Unbind a credential before changing its endpoint or type.</p>
    <div class="form-actions"><button class="button primary" type="submit">Encrypt and save</button><a class="button" href="/credentials">Cancel</a></div>
</form>
<aside>
    <section class="panel"><h2>Using a public repository?</h2><p>You do not need to create a credential. Add the repository as a Git source and select <strong>Public repository (no credential)</strong>.</p><a class="button" href="/sources">Open Git sources</a></section>
    <section class="panel"><h2>Credential safety</h2><p class="field-help">Secrets are encrypted with the persisted instance keys. Use a scoped access token with only the repository or image access you need.</p><p class="field-help">SSH keys, insecure HTTP, submodules, local files, and embedded URL passwords are not supported.</p></section>
</aside>
</div>
