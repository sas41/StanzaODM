@model CredentialListModel
@{ ViewData["Title"] = "Git and registry credentials"; }
<h1>Git and registry credentials</h1>
<p>Secrets are encrypted at rest. Reading metadata, using credentials, changing credentials, and revealing secrets are separately authorized.</p>
<p>Checks run on an explicitly selected approved Agent, never on the Control Plane. HTTPS intranet repositories and registries are supported. Agent/Docker access is privileged and can access the Agent's internal network. Do not grant access to untrusted operators.</p>
@if (Model.CanCreate) { <a class="button" href="/credentials/create">Add credential / registry</a> }
@if (Model.Credentials.Count == 0) { <p>No readable credentials. Ask an administrator for credential.read access or create one if authorized.</p> }
@foreach (var item in Model.Credentials)
{
    <section class="panel">
        <h2>@item.Name</h2><p>@item.Kind · @item.Endpoint</p>
        <a href="/credentials/@item.Id/edit">Edit / rotate</a>
        <form method="post" action="/credentials/@item.Id/reveal">@Html.AntiForgeryToken()<button class="button" type="submit">Reveal secret (requires reveal permission)</button></form>
        <form method="post" action="/credentials/@item.Id/test">
            @Html.AntiForgeryToken()
            <label>Test from Agent
                <select name="targetAgentId" required>
                    <option value="">Select approved Agent</option>
                    @foreach (var agent in Model.Agents) { <option value="@agent.Id">@agent.Name (@agent.Id)</option> }
                </select>
            </label>
            <button class="button" type="submit" disabled="@(Model.Agents.Count == 0)">Test connection (requires use permission)</button>
        </form>
        <form method="post" action="/credentials/@item.Id/delete">
            @Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@item.Version" />
            <p>Deletion is blocked while a deployment references this credential.</p>
            <button class="button" type="submit">Delete credential</button>
        </form>
    </section>
}
