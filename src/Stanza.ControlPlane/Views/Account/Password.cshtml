@model ChangePasswordModel
@{ ViewData["Title"] = "Account security"; }
<span class="eyebrow">YOUR ACCOUNT</span><h1>Account security</h1><p class="muted">Changing your password revokes existing sessions.</p>
<section class="panel narrow"><form method="post" asp-action="Password">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password" required />
    <label asp-for="NewPassword">New password</label><input asp-for="NewPassword" autocomplete="new-password" minlength="12" maxlength="1024" required />
    <label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password" required />
    <button class="button primary" type="submit">Change password</button>
</form></section>
