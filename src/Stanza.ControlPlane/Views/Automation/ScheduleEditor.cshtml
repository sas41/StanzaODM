@model ScheduleEditorModel
@{ ViewData["Title"] = "Schedule editor"; }
<h1>Schedule editor</h1>
<form method="post" action="/automation/schedules/edit" class="panel form-grid">@Html.AntiForgeryToken()
<div asp-validation-summary="All"></div><input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
<div class="field"><label asp-for="Name"></label><input asp-for="Name" /></div>
<div class="field"><label asp-for="DeploymentId">Deployment (optional for action schedules)</label><select asp-for="DeploymentId"><option value="">No deployment — action only</option>@await Html.PartialAsync("_DeploymentOptions", Model.DeploymentId)</select></div>
<div class="field"><label asp-for="ActionId">Action (optional)</label><select asp-for="ActionId"><option value="">Use deployment operation below</option>@await Html.PartialAsync("_ActionOptions", Model.ActionId)</select></div>
<div class="field"><label asp-for="Operation">Operation (when no action selected)</label><select asp-for="Operation">@foreach (var op in Stanza.ControlPlane.Automation.AutomationRules.Operations) { <option value="@op">@op</option> }</select></div>
<div class="field"><label asp-for="Expression">Cron: minute hour day-of-month month weekday</label><input asp-for="Expression" /></div>
<div class="field"><label asp-for="TimeZone">IANA timezone (for example UTC or America/New_York)</label><input asp-for="TimeZone" /></div>
<div class="field"><label asp-for="Overlap"></label><select asp-for="Overlap"><option value="skip">Skip overlapping occurrence</option><option value="queue">Queue overlapping occurrence</option></select></div>
<div class="field"><label asp-for="MissedRun"></label><select asp-for="MissedRun"><option value="skip">Skip occurrences missed by over one minute</option><option value="run-once">Run once after downtime; do not replay every missed occurrence</option></select></div>
<label class="check-field span-full"><input asp-for="Enabled" /> Enabled</label>
<div class="form-actions"><button class="primary" type="submit">Save schedule</button>
<button type="submit" formaction="/automation/schedules/preview" hx-post="/automation/schedules/preview" hx-target="#occurrences" hx-include="closest form">Preview next five runs</button></div>
</form>
<div id="occurrences"></div>
<details class="help-disclosure"><summary>Scheduled inputs, timezone rules, and recovery</summary>
<p>Action schedules use the shared last-used inputs, falling back to defaults. Required inputs must have a remembered value or default before enabling a schedule. To schedule a host-only action, select it and leave deployment empty. You can also configure schedules directly from the action editor.</p>
<p>Five-field cron supports numeric lists, ranges and steps. Weekday 0/7 is Sunday. Restricted day-of-month and weekday are ORed. During spring DST gaps, nonexistent local times are skipped. During autumn ambiguity, a local time runs once at its earlier UTC occurrence. All history timestamps are UTC.</p>
<p>Configuration is persisted, and due occurrences are claimed atomically. A run interrupted after dispatch becomes uncertain and is not replayed automatically. An action/policy lock remains until an operator reconciles it.</p>
</details>
