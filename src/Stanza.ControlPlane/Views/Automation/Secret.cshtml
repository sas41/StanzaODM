@model WebhookSecretModel
@{ ViewData["Title"] = "Webhook secret"; }
<h1>Copy your webhook signing secret now</h1>
<p>This secret will not be displayed again. It is not stored in browser TempData or delivery history. Rotating it invalidates the previous secret immediately.</p>
<p>Endpoint: <code>/hooks/@Model.Id</code></p><pre>@Model.Secret</pre>
<a href="/automation">I have saved the secret</a>
