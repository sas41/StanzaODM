@model WebhookEditorModel
@{ ViewData["Title"] = "Webhook editor"; }
<h1>Webhook editor</h1>
<form method="post" action="/automation/webhooks/edit" class="panel form-grid">@Html.AntiForgeryToken()
<div asp-validation-summary="All"></div><input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
<div class="field"><label asp-for="Name"></label><input asp-for="Name" /></div>
<div class="field"><label asp-for="DeploymentId">Owning deployment</label><select asp-for="DeploymentId"><option value="">Select deployment</option>@await Html.PartialAsync("_DeploymentOptions", (Guid?)Model.DeploymentId)</select></div>
<div class="field"><label asp-for="ActionId">Action (optional)</label><select asp-for="ActionId"><option value="">Use deployment operation below</option>@await Html.PartialAsync("_ActionOptions", Model.ActionId)</select></div>
<div class="field"><label asp-for="Operation">Operation (when no action selected)</label><select asp-for="Operation">@foreach (var op in Stanza.ControlPlane.Automation.AutomationRules.Operations) { <option value="@op">@op</option> }</select></div>
<div class="field"><label asp-for="Provider"></label><select asp-for="Provider"><option value="github">GitHub</option><option value="generic">Generic signed JSON</option></select></div>
<div class="field"><label asp-for="Events">Accepted events (comma-separated exact names)</label><input asp-for="Events" /></div>
<div class="field"><label asp-for="Refs">Accepted refs (comma-separated exact refs; empty accepts all)</label><textarea asp-for="Refs" rows="3"></textarea></div>
<div class="field"><label asp-for="ParameterMapping">Parameter mapping JSON: parameter name to payload object path</label><textarea asp-for="ParameterMapping" rows="3"></textarea></div>
<label class="check-field span-full"><input asp-for="Enabled" /> Enabled</label><div class="form-actions"><button class="primary">Save webhook</button></div></form>
<details class="help-disclosure"><summary>Signatures, headers, and parameter mapping</summary>
<p>The secret is encrypted at rest and shown only once on creation/rotation. All requests use HMAC-SHA256 of the exact raw request body, formatted as <code>sha256=HEX_DIGEST</code>. Use HTTPS.</p>
<p>GitHub headers: X-Hub-Signature-256, X-GitHub-Delivery, X-GitHub-Event. Generic headers: X-Stanza-Signature-256, X-Stanza-Delivery, X-Stanza-Event. JSON must be an object; ref filters compare the top-level ref (e.g. refs/heads/main).</p>
<p>Example mapping: <code>{"message":"head_commit.message"}</code>. Only declared typed parameters can receive scalar JSON fields; they replace whole structured arguments only. Targets and executables cannot be set by payloads. Delivery IDs are deduplicated for the configured history-retention period; reuse an ID only for retries.</p>
</details>
