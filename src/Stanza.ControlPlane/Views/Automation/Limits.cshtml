@model Stanza.ControlPlane.Automation.AutomationLimits
@{ ViewData["Title"] = "Automation limits"; }
<h1>Automation limits and retention</h1>
<form method="post" action="/automation/limits" class="panel form-grid">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div>
<div class="field"><label asp-for="MaximumWebhookBytes">Webhook payload bytes (1024–1048576)</label><input asp-for="MaximumWebhookBytes" type="number" min="1024" max="1048576" /></div>
<div class="field"><label asp-for="DeliveriesPerMinute">Authenticated unique deliveries per webhook/minute (1–10000)</label><input asp-for="DeliveriesPerMinute" type="number" min="1" max="10000" /></div>
<div class="field"><label asp-for="HistoryRetentionDays">Run/delivery history retention days (1–3650)</label><input asp-for="HistoryRetentionDays" type="number" min="1" max="3650" /></div>
<div class="field"><label asp-for="MaximumQueuedRuns">Maximum queued runs (1–100000)</label><input asp-for="MaximumQueuedRuns" type="number" min="1" max="100000" /></div>
<div class="form-actions"><button class="primary">Apply limits</button></div></form>
<p>Limits take effect without restart. Delivery replay protection lasts for the retention period. Active and uncertain runs are not pruned automatically.</p><a href="/automation">Back</a>
