@model Stanza.ControlPlane.Automation.AutomationLimits
@{ ViewData["Title"] = "Automation limits"; }
<h1>Automation limits and retention</h1>
<form method="post" action="/automation/limits" class="panel form-grid">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div>
<div class="field"><label asp-for="MaximumWebhookBytes">Webhook payload bytes</label><input asp-for="MaximumWebhookBytes" type="number" min="0" /><p class="field-help">Default 65,536 bytes. 0: unlimited payload size.</p></div>
<div class="field"><label asp-for="DeliveriesPerMinute">Authenticated unique deliveries per webhook/minute</label><input asp-for="DeliveriesPerMinute" type="number" min="0" /><p class="field-help">Default 60. 0: unlimited delivery rate; signature and replay checks remain enabled.</p></div>
<div class="field"><label asp-for="HistoryRetentionDays">Run/delivery history retention days</label><input asp-for="HistoryRetentionDays" type="number" min="0" max="3650" /><p class="field-help">Default 30 days. 0: retain forever, including delivery replay evidence.</p></div>
<div class="field"><label asp-for="MaximumQueuedRuns">Maximum queued runs</label><input asp-for="MaximumQueuedRuns" type="number" min="0" /><p class="field-help">Default 1,000. 0: unlimited queue length.</p></div>
<div class="form-actions"><button class="primary">Apply limits</button></div></form>
<p>Limits take effect without restart. Delivery replay protection lasts for the retention period. Active and uncertain runs are not pruned automatically.</p><a href="/automation">Back</a>
