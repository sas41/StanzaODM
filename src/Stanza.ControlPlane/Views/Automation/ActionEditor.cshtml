@model ActionEditorModel
@{ ViewData["Title"] = "Action editor"; }
<div class="page-heading"><div><span class="eyebrow">FIXED STEPS · SCOPED ACCESS</span><h1>Action editor</h1><p>Build a deployment button with bound inputs, ordered steps, and optional cron schedules.</p></div><a class="button subtle" href="/automation">All actions</a></div>
<div class="workspace action-workspace">
<div>
<form method="post" action="/automation/actions/edit">@Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
    <div class="action-top-grid">
    <section class="panel"><h2>Action details</h2><div class="form-grid">
        <div class="field"><label asp-for="Name"></label><input asp-for="Name" /></div>
        <div class="field"><label asp-for="Concurrency"></label><select asp-for="Concurrency"><option value="queue">Queue conflicting action runs</option><option value="reject">Reject overlapping runs</option></select></div>
        <label class="check-field span-full"><input asp-for="Enabled" /> Enable this action</label>
    </div></section>
        <section class="panel" data-action-button hidden><h2>Overview button</h2><div class="form-grid">
            <label class="field">Deployment<select data-plan-deployment><option value="">No overview button</option>
            @foreach (var d in ViewData["ActionDeployments"] as IReadOnlyList<Stanza.ControlPlane.Sources.DeploymentSourceSummary> ?? []) { <option value="@d.DeploymentId">@d.Name</option> }
            </select></label>
            <label class="field">Button label<input data-plan-label maxlength="100" placeholder="Uses action name if empty" /></label>
            <details class="span-full"><summary>Button order, visibility &amp; confirmation</summary><div class="form-grid">
                <label class="field">Button order<input data-plan-order type="number" min="0" max="10000" value="0" /></label>
                <label class="check-field"><input data-plan-visible type="checkbox" checked /> Show on overview</label>
                <label class="field span-full">Confirmation message (optional)<input data-plan-confirmation maxlength="1000" placeholder="For example: Reset this environment's database?" /></label>
            </div></details>
        </div></section>
    </div>
    <section data-action-editor hidden>
        <section class="panel"><div class="panel-heading"><h2>Inputs</h2><button type="button" data-add-input>Add input</button></div>
            <p class="field-help">Branch inputs bind to a configured Git source. Version inputs bind to an image repository and Compose services. Public sources need no credential.</p>
            <div data-editor-inputs></div>
        </section>
        <section class="panel"><div class="panel-heading"><h2>Steps</h2><button type="button" data-add-step>Add step</button></div>
            <p class="field-help">Steps run in order. Choose a deployment operation, a fixed container command, or an explicitly permitted host command.</p>
            <div data-editor-steps></div><p data-editor-error class="validation" role="alert"></p>
        </section>
    </section>
    <details class="help-disclosure" data-advanced-plan><summary>Advanced action plan JSON / no-JavaScript editor</summary>
        <label asp-for="PlanJson">Action plan JSON</label><textarea asp-for="PlanJson" rows="12" spellcheck="false"></textarea>
    </details>
    <div class="form-actions"><button class="primary" type="submit">Save action</button><button type="submit" name="configureSchedule" value="true">Save and configure schedule</button><a class="button subtle" href="/automation">Cancel</a></div>
</form>
<details class="help-disclosure"><summary>Execution rules, permissions, and plan format</summary>
    <p>Steps execute in order. Editing changes execution ownership to you. An action grant delegates only these fixed steps and constrained inputs, never arbitrary commands. Saved runs retain an immutable plan.</p>
    <p>Supported kinds: git-refresh, validate, build, pull, deploy, start, stop, restart, remove, status, logs, container-exec, host-exec. Git refresh resolves configured sources into an isolated operation snapshot and validates Compose; it requires sources.manage and deployment.validate. Build/deploy also resolve immutable source snapshots.</p>
    <p>Every operation uses the global timeout in Settings (default one hour; 0 means unlimited). Old step timeout values are preserved but do not override it. Steps support a stop/continue failure policy. Cancellation cannot roll back side effects.</p>
    <pre>{"steps":[{"kind":"container-exec","deploymentId":"DEPLOYMENT_ID","failure":"stop","execution":{"executable":"/usr/bin/printf","arguments":["%s","${message}"],"service":"app"}}],"parameters":[{"name":"message","type":"string","required":true,"default":null}]}</pre>
    <p>Inputs support text, fixed dropdowns, image tags and Git branches. Bound selections apply to execution snapshots, not managed files. Other parameters replace only whole structured arguments, never executables or shell fragments. No shell is inserted.</p>
    <p><strong>Host prerequisites:</strong> host-exec needs a separate host.execute grant and an approved Agent with explicitly enabled host execution and an isolated host execution adapter. Stanza never enables host privileges automatically.</p>
    <p>Container steps select exactly one service or container. Missing or stopped targets fail; they are never automatically started by exec.</p>
</details>
</div>
<aside>
    <section class="panel" id="action-schedules"><h2>Periodic execution</h2>
        <p class="field-help">Each occurrence snapshots the <strong>shared last-used inputs</strong>.</p>
        @if (Model.Id is { } scheduledAction)
        {
            foreach (var schedule in ViewData["ActionSchedules"] as IReadOnlyList<Stanza.ControlPlane.Automation.AutomationSchedule> ?? [])
            { @await Html.PartialAsync("_ActionSchedule", schedule) }
            <h3>Add a schedule</h3>
            @await Html.PartialAsync("_ActionSchedule", new Stanza.ControlPlane.Automation.AutomationSchedule { ActionId = scheduledAction, Name = (Model.Name.Length > 91 ? Model.Name[..91] : Model.Name) + " schedule" })
        }
        else
        { <p>Save the action first using “Save and configure schedule”, then add cron schedules here.</p> }
        <details><summary>Scheduled inputs and cron examples</summary><p class="field-help">Defaults are used until an action has been run manually. Missing required inputs or unavailable branches/tags prevent execution. Scheduled runs never overwrite remembered values. <code>0 3 * * *</code> runs daily at 03:00 in the selected timezone.</p></details>
    </section>
    @if (Model.Id is { } actionId)
    {
        <section class="panel"><h2>Action access</h2><p>Grant QA permission to run this action without generic command access. Admins retain access to every enabled action.</p><a class="button" href="/automation/actions/@actionId/access">Manage action access →</a><p class="field-help"><code>action.execute / action / @actionId</code></p></section>
    }
    <details class="panel help-disclosure"><summary>Host maintenance example</summary><p class="field-help">For Docker pruning, use host-exec with executable <code>/usr/bin/docker</code> and arguments <code>system</code>, <code>prune</code>, <code>--force</code>, one per line.</p><p class="notice warning">This affects the entire Docker daemon, not just one deployment. It requires enabled host actions and a host-capable Agent. Keep maintenance actions admin-only. Volume cleanup is not included.</p></details>
</aside>
</div>
<template id="action-deployment-options"><option value="">Select deployment</option>
@foreach (var d in ViewData["ActionDeployments"] as IReadOnlyList<Stanza.ControlPlane.Sources.DeploymentSourceSummary> ?? []) { <option value="@d.DeploymentId">@d.Name</option> }
</template>
<template id="action-agent-options"><option value="">Select Agent</option>
@foreach (var a in ViewData["ActionAgents"] as IReadOnlyList<Stanza.ControlPlane.Sources.SourceAgentSummary> ?? []) { <option value="@a.Id">@a.Name</option> }
</template>
<template id="action-source-options"><option value="">Select Git source destination</option>
@foreach (var d in ViewData["ActionDeployments"] as IReadOnlyList<Stanza.ControlPlane.Sources.DeploymentSourceSummary> ?? [])
{ foreach (var g in d.Git) { <option value="@g.Destination" data-deployment="@d.DeploymentId">@d.Name / @g.Destination</option> } }
</template>
<script src="~/js/action-editor.js" defer asp-append-version="true"></script>
