@model ActionEditorModel
@{ ViewData["Title"] = "Action"; }
<div class="page-heading"><h1>@(Model.Id.HasValue ? "Edit action" : "New action")</h1><a class="button subtle" href="/automation">All actions</a></div>
<section class="panel">
<form method="post" action="/automation/actions/edit">@Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
    <div class="form-grid">
        <label class="field">Name<input asp-for="Name" /></label>
        <label class="field">Deployment scope<select asp-for="DeploymentId"><option value="">Global / Agent maintenance</option>
        @foreach (var d in ViewData["ActionDeployments"] as IReadOnlyList<Stanza.ControlPlane.Sources.DeploymentSourceSummary> ?? [])
        { <option value="@d.DeploymentId">@d.Name</option> }
        </select></label>
    </div>
    <label class="field">Agent (host maintenance only)<select asp-for="AgentId" title="For Host Docker actions without a deployment. Leave Deployment empty when selecting an Agent."><option value="">Use deployment's Agent</option>
    @foreach (var agent in ViewData["ActionAgents"] as IReadOnlyList<Stanza.ControlPlane.Sources.SourceAgentSummary> ?? [])
    { <option value="@agent.Id">@agent.Name</option> }
    </select></label>
    @await Html.PartialAsync("_WorkflowFields", Model)
    <label class="check-field"><input asp-for="Enabled" /> Enabled</label>
    <div class="form-actions"><button class="primary" type="submit">Save action</button><a class="button subtle" href="/automation">Cancel</a></div>
</form>
</section>
<script src="~/js/action-editor.js" defer asp-append-version="true"></script>
@if (Model.Id is { } actionId)
{
    <details class="panel"><summary>Periodic execution</summary>
        @foreach (var schedule in ViewData["ActionSchedules"] as IReadOnlyList<Stanza.ControlPlane.Automation.AutomationSchedule> ?? [])
        { @await Html.PartialAsync("_ActionSchedule", schedule) }
        @await Html.PartialAsync("_ActionSchedule", new Stanza.ControlPlane.Automation.AutomationSchedule { ActionId = actionId, Name = (Model.Name.Length > 91 ? Model.Name[..91] : Model.Name) + " schedule" })
    </details>
    <a class="button" href="/automation/actions/@actionId/access">Manage action access</a>
}
