@{
    bool Active(string path) => path == "/" ? Context.Request.Path == "/" : Context.Request.Path.StartsWithSegments(path);
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"selfRequestsOnly":true}' />
    <title>@(ViewData["Title"] ?? "Control Plane") · Stanza</title>
    <link rel="stylesheet" href="~/css/stanza.css" asp-append-version="true" />
    <script src="~/vendor/htmx.min.js" defer asp-append-version="true"></script>
    <script src="~/js/status.js" defer asp-append-version="true"></script>
    <script src="~/js/ui.js" defer asp-append-version="true"></script>
</head>
<body class="@(authenticated ? "app-layout" : "auth-layout")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <aside class="sidebar">
        <div class="sidebar-header">
        <a class="brand" href="/"><span class="brand-mark">S</span><span>Stanza<small>OPEN DEPLOYMENT MANAGER</small></span></a>
        @if (authenticated) { <button type="button" class="nav-toggle subtle" aria-controls="primary-navigation" aria-expanded="false">Menu</button> }
        </div>
        @if (authenticated)
        {
            <nav id="primary-navigation" aria-label="Main navigation">
                <div class="nav-label">WORKSPACE</div>
                <a href="/" aria-current="@(Active("/") ? "page" : null)">Overview</a>
                <a href="/deployments" aria-current="@(Active("/deployments") || Active("/logs") || Active("/terminals") ? "page" : null)">Deployments</a>
                <a href="/automation" aria-current="@(Active("/automation") ? "page" : null)">Actions &amp; automation</a>
                <a href="/operations" aria-current="@(Active("/operations") ? "page" : null)">Operations</a>
                <div class="nav-label">CONFIGURATION</div>
                <a href="/agents" aria-current="@(Active("/agents") ? "page" : null)">Agents</a>
                <a href="/sources" aria-current="@(Active("/sources") ? "page" : null)">Git sources</a>
                <a href="/credentials" aria-current="@(Active("/credentials") ? "page" : null)">Credentials &amp; registries</a>
                <a href="/portability" aria-current="@(Active("/portability") ? "page" : null)" title="Clone, move and import/export configuration">Clone, move &amp; transfer</a>
                <a href="/settings" aria-current="@(Active("/settings") || Active("/policy") ? "page" : null)">Settings</a>
                @if (User.IsInRole("Admin") || User.IsInRole("SystemAdmin"))
                {
                    <div class="nav-label">ADMINISTRATION</div>
                    <a href="/users" aria-current="@(Active("/users") ? "page" : null)">Users</a>
                    <a href="/groups" aria-current="@(Active("/groups") ? "page" : null)">Groups &amp; permissions</a>
                    <a href="/audit" aria-current="@(Active("/audit") ? "page" : null)">Audit history</a>
                    <a href="/recovery" aria-current="@(Active("/recovery") ? "page" : null)">Backup &amp; recovery</a>
                }
                <a href="/account/password" aria-current="@(Active("/account/password") ? "page" : null)">Account security</a>
            </nav>
            <div class="sidebar-footer"><div><strong>@User.Identity!.Name</strong><span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></div>
                <form method="post" asp-controller="Account" asp-action="Logout"><button class="button subtle" type="submit">Sign out</button></form>
            </div>
        }
        else
        {
            <p class="sidebar-copy">Your servers.<br />Your deployments.<br />One control plane.</p>
        }
    </aside>
    <main id="main-content" tabindex="-1">
        <header class="topbar"><span>STANZA <span class="current-page">/ @(ViewData["Title"] ?? "Control Plane")</span></span><span class="version">.NET 10 LTS</span></header>
        <div class="content">
            @if (!Context.Request.IsHttps && (Context.RequestServices.GetService(typeof(Stanza.ControlPlane.Configuration.HttpTransportPolicy)) as Stanza.ControlPlane.Configuration.HttpTransportPolicy)?.AllowInsecureHttp == true)
            {
                <div class="notice warning" role="alert" data-insecure-http-warning><strong>Insecure HTTP mode is enabled.</strong> This connection is not encrypted. Passwords, sessions, Agent enrollment credentials, deployment secrets and privileged commands can be intercepted. Use only on a trusted network; HTTPS is recommended.</div>
            }
            @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
            @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
            @RenderBody()
        </div>
    </main>
</body>
</html>
