@model Stanza.ControlPlane.Operations.OperationDetail
@{ ViewData["Title"] = "Operation"; }
<section data-operation-id="@Model.Summary.Id"><h1>@Model.Summary.Kind</h1><p><code>@Model.Summary.Id</code> · <strong data-operation-state>@Model.Summary.State</strong> · <span data-operation-code>@Model.Summary.Code</span></p>
<p>Agent: @Model.Summary.AgentId · Deployment: @Model.Summary.DeploymentId · Trigger: @Model.Summary.Trigger</p>
@if (Model.BlockingOperationId is { } blocker) { <p class="notice warning">Blocked by <a href="/operations/@blocker">operation @blocker — inspect and recover</a>. Unresolved execution is never unlocked by a timeout.</p> }
@if (!Stanza.ControlPlane.Operations.OperationService.Terminal(Model.Summary.State) || Model.Summary.State == "Unknown") { <form method="post" asp-action="Cancel" asp-route-id="@Model.Summary.Id"><button class="button" type="submit">Request cancellation</button></form><p class="field-help">Cancellation cannot undo side effects already performed or release unresolved locks. Persisted state updates arrive over the authenticated live connection.</p> }
<p>Last persisted phase: @Model.Phase · Cancellation reason: @(Model.CancellationReason ?? "none recorded")</p>
@if (Model.Summary.Code == "interrupted_before_apply" && Model.Summary.DeploymentId is { } retryDeployment) { <p class="notice">Execution stopped before deployment apply began. <a href="/deployments/@retryDeployment">Review the deployment and retry explicitly</a>. A retry is a new operation; the interrupted operation is never replayed.</p> }
@if (Model.Summary.State == "Unknown") { <div class="notice warning">Execution may still be active. Inspection checks the Agent ledger and refreshes container status, then reconciles the operation and its automation run together. Missing evidence or active work keeps all locks held. No commands are replayed.</div><form method="post" asp-action="Reconcile" asp-route-id="@Model.Summary.Id"><label><input type="checkbox" name="acknowledged" value="true" /> If apply began, I have inspected the target and acknowledge its side effects. This does not undo changes.</label><button class="button" type="submit">Inspect and reconcile</button></form> }
@if (Model.Disconnects.Count > 0) { <section class="panel"><h2>Retained disconnect diagnostics</h2><table><thead><tr><th>At (UTC)</th><th>Reason / close status</th><th>Phase</th><th>Last heartbeat</th><th>Acknowledged output</th></tr></thead><tbody>@foreach (var item in Model.Disconnects) { <tr><td>@DateTimeOffset.FromUnixTimeSeconds(item.At).ToString("u")</td><td>@item.Reason / @item.CloseStatus</td><td>@item.Phase</td><td>@item.LastHeartbeat</td><td>@item.AcknowledgedSequence</td></tr> }</tbody></table></section> }
<section class="panel"><h2>Operation output</h2>
<p data-output-notice>@(!Model.OutputAllowed ? "You do not have permission to read this operation's output." : "Connecting to operation output. Output is retained according to Settings; expired or previously discarded output cannot be recovered.")</p>
@if (Model.OutputAllowed) { <label><input type="checkbox" data-output-follow checked /> Follow output</label><a href="/operations/@Model.Summary.Id/output">Download retained output</a> }
<pre data-operation-output hidden="@(Model.Output is null)">@Model.Output</pre></section>
<a href="/operations">← Operations</a>
</section><script src="~/js/operations.js" defer asp-append-version="true"></script>
