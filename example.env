# Copy to .env before starting; never commit your populated .env or share enrollment tokens.
# Optional unique Compose project name; otherwise the installation folder name is used.
# COMPOSE_PROJECT_NAME=CHANGE_ME_unique_project

# Application images: latest, or the SAME UTC release tag for CP and Agents (YYYY-MM-DD-HHMMSS).
STANZA_VERSION=latest

# Control Plane listener. Keep loopback for a local reverse proxy; 0.0.0.0 exposes the host port.
STANZA_BIND_ADDRESS=127.0.0.1
STANZA_HTTP_PORT=8080

# Default false. True permits unencrypted browser AND Agent traffic on trusted LANs only.
# Must be enabled on BOTH Control Plane and Agent deployments when their connection uses HTTP.
STANZA_ALLOW_INSECURE_HTTP=false

# Address reachable FROM the Agent container, not the container's own localhost.
# HTTPS requires a valid certificate/reverse proxy. For LAN HTTP see README.md.
STANZA_CONTROL_PLANE_URL=https://CHANGE_ME.example.com

# Create this in Control Plane → Agents after initial setup, before starting the Agent.
STANZA_ENROLLMENT_TOKEN=CHANGE_ME_generate_a_fresh_token_in_the_Control_Plane_UI
STANZA_AGENT_NAME=local-agent

# On the Docker host run: stat -c '%g' /var/run/docker.sock
# There is no universal socket group ID; replace this with the numeric result.
STANZA_DOCKER_GID=CHANGE_ME
